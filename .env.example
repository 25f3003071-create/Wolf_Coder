# ===================================================
# RELIEFTRACK PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# 1. PUBLIC CLIENT-SIDE VARIABLES (Safe to expose to browser)
NEXT_PUBLIC_APP_URL=https://relieftrack.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_RELIEF_TRACKER_ADDRESS=0x8a7291bc44f128e932104975193a218f77361a90
NEXT_PUBLIC_RELIEF_TRACKER_ADDRESS_AMOY=0x991823abf772183e910293a8172bc9102931bc

# 2. SERVER-ONLY SECRETS (NEVER expose to client browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-expose
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# 3. TWILIO SMS GATEWAY (Server-Only Secrets)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# 4. BLOCKCHAIN NODE & DEPLOYER (Server / CLI-Only Secrets)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_do_not_commit

# 5. DEPLOYMENT & PORT
PORT=3000
